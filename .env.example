# Shopify Storefront API Configuration
# Replace these with your actual Shopify store credentials to link your store:

# 1. Your Shopify myshopify.com domain (e.g. your-store-name.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN=j7wxjk-ay.myshopify.com

# 2. Your public Storefront API Access Token (found in Shopify Admin > Settings > Apps and sales channels > Develop apps > Storefront API)
VITE_SHOPIFY_STOREFRONT_TOKEN=3c5d16a55e27b6d26dbe421f5d5a6b4e

# 3. Shopify API Version (defaults to 2026-10 or 2024-01 / 2024-07 / 2024-10)
VITE_SHOPIFY_API_VERSION=2026-10
